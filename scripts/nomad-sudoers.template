# Nomad Pi web-admin privileges.
#
# The installer used to write `__USER__ ALL=(ALL) NOPASSWD: ALL`, which made a
# web request from the media server equivalent to a root shell. Nomad needs
# real privilege for four jobs and nothing else: power (reboot/shutdown),
# storage (mount/unmount/format), networking (Wi-Fi, hotspot, remote access),
# and updating itself. Everything below is scoped to those.
#
# __ROOT__ is the Nomad checkout; only scripts shipped inside it are grantable.
# Generated by scripts/install-common.sh — edit the template, not the installed
# file, or the next update will overwrite your changes.

Cmnd_Alias NOMAD_POWER = /usr/sbin/reboot, /sbin/reboot, /usr/sbin/shutdown, /sbin/shutdown

# A drive can be mounted under /media, /mnt, or data/external inside the Nomad
# checkout. Omitting the third meant a drive mounted there stayed root-owned
# and the library could not read it — the mount itself succeeded, so the
# failure was silent.
Cmnd_Alias NOMAD_STORAGE = /usr/bin/mount, /bin/mount, /usr/bin/umount, /bin/umount, \
                           /usr/sbin/mkfs, /sbin/mkfs, /usr/sbin/mkfs.*, /sbin/mkfs.*, \
                           /usr/bin/chown [0-9]*\:[0-9]* /media/*, \
                           /usr/bin/chown [0-9]*\:[0-9]* /mnt/*, \
                           /usr/bin/chown [0-9]*\:[0-9]* __ROOT__/data/external/*, \
                           /usr/bin/chmod o+rx /media/*, \
                           /usr/bin/chmod o+rx /mnt/*, \
                           /usr/bin/chmod 0775 /media/*, \
                           /usr/bin/chmod 0775 /mnt/*, \
                           /usr/bin/chmod 0775 __ROOT__/data/external/*

Cmnd_Alias NOMAD_NETWORK = /usr/bin/nmcli, /bin/nmcli, \
                           /usr/sbin/rfkill, /usr/bin/rfkill, \
                           /usr/bin/tailscale, /usr/sbin/tailscale, \
                           __ROOT__/scripts/nomad-wifi-restart.sh, \
                           __ROOT__/scripts/wifi-guard.sh

# Only Nomad's own units. A bare `systemctl` grant would let a web request
# start any unit on the box, which is root by another name.
Cmnd_Alias NOMAD_SERVICES = /usr/bin/systemctl restart nomad-pi.service, \
                            /usr/bin/systemctl start nomad-pi.service, \
                            /usr/bin/systemctl stop nomad-pi.service, \
                            /usr/bin/systemctl restart minidlna, \
                            /usr/bin/systemctl start minidlna, \
                            /usr/bin/systemctl stop minidlna, \
                            /usr/bin/systemctl restart tailscaled, \
                            /usr/bin/systemctl start tailscaled, \
                            /usr/bin/systemctl stop tailscaled, \
                            /usr/bin/systemctl enable --now tailscaled, \
                            /usr/bin/systemctl disable tailscaled, \
                            /usr/bin/systemctl daemon-reload

# minidlna keeps its index outside the Nomad tree, so rebuilding the DLNA
# library needs these three paths — and only these three.
Cmnd_Alias NOMAD_DLNA = /usr/bin/rm -f /var/cache/minidlna/files.db, \
                        /usr/bin/mkdir -p /var/cache/minidlna, \
                        /usr/bin/mkdir -p /var/log/minidlna, \
                        /usr/bin/chown -R minidlna\:minidlna /var/cache/minidlna, \
                        /usr/bin/chown -R minidlna\:minidlna /var/log/minidlna

# `sudo -n true` is how the diagnostics pages ask "do I have passwordless
# sudo?". Without it they report sudo as unavailable on a correctly configured
# device, sending the operator to debug a problem that does not exist.
Cmnd_Alias NOMAD_DIAG = /usr/bin/true, /bin/true, \
                        /usr/bin/journalctl -u minidlna *, \
                        /usr/bin/tail -30 /var/log/minidlna/*, \
                        /usr/bin/tail -n 30 /var/log/minidlna/*

# Self-update. The updater re-execs as this user and does its own privileged
# work through the aliases above.
Cmnd_Alias NOMAD_UPDATE = __ROOT__/update.sh, __ROOT__/setup.sh

__USER__ ALL=(ALL) NOPASSWD: NOMAD_POWER, NOMAD_STORAGE, NOMAD_NETWORK, \
                             NOMAD_SERVICES, NOMAD_DLNA, NOMAD_DIAG, NOMAD_UPDATE
